# Azure OpenAI application deployment
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Keep the judge separate so quality measurement can evolve independently.
AZURE_OPENAI_EVALUATOR_DEPLOYMENT=

# Phoenix client and OTLP collector. For local Phoenix both use port 6006.
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=phoenix-llm-observability-dev
PHOENIX_API_KEY=
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_BATCH_EXPORT=false

# Privacy: false redacts prompt, response, message, and embedding text from traces.
# Enable only for the repository's fictional demo data.
PHOENIX_TRACE_CONTENT=false
PHOENIX_DOCUMENT_PREVIEW_CHARS=200

# RAG behavior: lexical works locally; azure_embeddings traces embedding calls.
RAG_RETRIEVER_MODE=lexical
RAG_TOP_K=3
RAG_MIN_SCORE=0.05

# Example CI quality thresholds. Calibrate these on your own representative data.
MIN_FAITHFULNESS=0.80
MIN_ANSWER_RELEVANCE=0.75
MIN_RETRIEVAL_RELEVANCE=0.75
MIN_CORRECTNESS=0.75

